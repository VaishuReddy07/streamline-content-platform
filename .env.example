# Reference configuration for running the API/worker directly on the host.
# Docker Compose defines its own container-network values in docker-compose.yml.
DATABASE_URL=postgres://streamline:streamline-local@localhost:5433/streamline
AWS_REGION=eu-west-3
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=partner-exports
SQS_DLQ_QUEUE_NAME=partner-exports-dlq
PARTNER_EXPORT_MODE=mock
# These test credentials are for LocalStack only. Never use them with AWS.
# Optional partner endpoints; provide real credentials through a secret manager.
# PARTNER_FREE_URL=
# PARTNER_GOOGLE_URL=
# PARTNER_SIRI_URL=
RUN_SCHEMA_SETUP=true
WEB_ORIGIN=http://localhost:5173
